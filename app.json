{
  "expo": {
    "name": "RoboReady",
    "slug": "roboready",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "statusBar": {
      "style": "auto",
      "backgroundColor": "transparent",
      "translucent": true,
      "hidden": false
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#007AFF"
    },
    "adaptiveIcon": {
      "foregroundImage": "./assets/adaptive-icon.png",
      "backgroundColor": "#007AFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.roboready.app",
      "userInterfaceStyle": "automatic",
      "requireFullScreen": false,
      "supportedInterfaceOrientations": ["portrait", "portrait-upside-down"],
      "infoPlist": {
        "NSCalendarsUsageDescription": "This app needs access to your calendar to add tournament events and reminders.",
        "NSRemindersUsageDescription": "This app needs access to reminders to schedule tournament notifications.",
        "UIBackgroundModes": ["background-app-refresh"],
        "UIUserInterfaceStyle": "Automatic",
        "UIStatusBarStyle": "UIStatusBarStyleDefault"
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.roboready.app",
      "permissions": [
        "android.permission.CALENDAR",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK"
      ]
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow RoboReady to access your calendar to add tournament events."
        }
      ]
    ]
  }
} 