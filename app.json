{
  "expo": {
    "name": "RoboReady",
    "slug": "roboready",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.roboready.app",
      "infoPlist": {
        "NSCalendarsUsageDescription": "This app needs access to your calendar to add tournament events and reminders.",
        "NSRemindersUsageDescription": "This app needs access to reminders to schedule tournament notifications."
      }
    },
    "android": {
      "package": "com.roboready.app",
      "permissions": [
        "android.permission.CALENDAR",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications"
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow RoboReady to access your calendar to add tournament events."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "your-project-id-here"
      }
    }
  }
} 